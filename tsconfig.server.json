{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "rootDir": ".",
    "outDir": "dist-server",
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["server"],
  "exclude": ["**/*.test.ts"]
}
