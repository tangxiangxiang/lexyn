{
  "name": "lexyn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "dev:web": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "build": "vite build && node scripts/build-sw.mjs && tsc -p tsconfig.server.json",
    "owner:init": "node --env-file-if-exists=.env server/auth/init-owner.ts",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "backup:create": "node --env-file-if-exists=.env dist-server/server/backup/cli.js create",
    "backup:verify": "node --env-file-if-exists=.env dist-server/server/backup/cli.js verify",
    "backup:restore": "node --env-file-if-exists=.env dist-server/server/backup/cli.js restore",
    "backup:restore-json": "node --env-file-if-exists=.env dist-server/server/backup/cli.js restore-json",
    "dictionary:import": "node --env-file-if-exists=.env server/dictionary/cli.ts",
    "owner:init:production": "node dist-server/server/auth/init-owner.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.0.0",
    "naive-ui": "^2.0.0",
    "papaparse": "^5.7.0",
    "ts-fsrs": "6.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.0"
  }
}
